rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function isValidId(id) {
      return id is string &&
        id.size() > 0 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedUser() &&
        request.auth.token.email == 'akhilpal1056@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedOwner() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation blueprint matching CustomerReview in firebase-blueprint.json
    function isValidReview(data) {
      return data.keys().hasAll([
          'authorName',
          'location',
          'purchaseCategory',
          'rating',
          'comment',
          'status',
          'helpfulCount',
          'authorUid',
          'verifiedAccount',
          'ownerReply',
          'ownerRepliedAt',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'authorName',
          'location',
          'purchaseCategory',
          'rating',
          'comment',
          'status',
          'helpfulCount',
          'authorUid',
          'verifiedAccount',
          'ownerReply',
          'ownerRepliedAt',
          'createdAt'
        ]) &&
        data.authorName is string &&
        data.authorName.size() >= 2 &&
        data.authorName.size() <= 60 &&
        data.location is string &&
        data.location.size() >= 2 &&
        data.location.size() <= 60 &&
        data.purchaseCategory in [
          'Kadaknath Chickens',
          'Kadaknath Chicks',
          'Kadaknath Eggs',
          'Farm Visit'
        ] &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.comment is string &&
        data.comment.size() >= 10 &&
        data.comment.size() <= 500 &&
        data.status in ['published', 'hidden'] &&
        data.helpfulCount is int &&
        data.helpfulCount >= 0 &&
        data.helpfulCount <= 100000 &&
        data.authorUid is string &&
        data.authorUid.size() <= 128 &&
        data.verifiedAccount is bool &&
        data.ownerReply is string &&
        data.ownerReply.size() <= 400 &&
        (data.ownerRepliedAt == null || data.ownerRepliedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    // Validation blueprint matching CustomerEnquiry in firebase-blueprint.json
    function isValidEnquiry(data) {
      return data.keys().hasAll([
          'name',
          'mobile',
          'message',
          'status',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'mobile',
          'message',
          'status',
          'createdAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 60 &&
        data.mobile is string &&
        data.mobile.size() >= 10 &&
        data.mobile.size() <= 20 &&
        data.message is string &&
        data.message.size() >= 5 &&
        data.message.size() <= 500 &&
        data.status in ['new', 'contacted'] &&
        data.createdAt is timestamp;
    }

    // Validation blueprint matching AdminUser in firebase-blueprint.json
    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 120 &&
        data.role == 'owner' &&
        data.createdAt is timestamp;
    }

    // Validation blueprint matching FarmSettings in firebase-blueprint.json
    function isValidFarmSettings(data) {
      return data.keys().hasAll([
          'phoneDisplay',
          'whatsappDigits',
          'email',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'phoneDisplay',
          'whatsappDigits',
          'email',
          'updatedAt'
        ]) &&
        data.phoneDisplay is string &&
        data.phoneDisplay.size() >= 8 &&
        data.phoneDisplay.size() <= 24 &&
        data.whatsappDigits is string &&
        data.whatsappDigits.size() >= 10 &&
        data.whatsappDigits.size() <= 15 &&
        data.whatsappDigits.matches('^[0-9]+$') &&
        data.email is string &&
        data.email.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Health check document for getDocFromServer boot verification
    match /test/{connectionId} {
      allow get: if isValidId(connectionId) && connectionId == 'connection';
      allow list, write: if false;
    }

    // Customer feedback: live publishing, verified Google author edit/delete, helpful votes, owner replies
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        existing().status == 'published' ||
        isAdmin() ||
        (isVerifiedUser() && existing().authorUid != '' && existing().authorUid == request.auth.uid)
      );
      allow list: if resource.data.status == 'published' || isBootstrappedOwner();
      allow create: if isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().helpfulCount == 0 &&
        (
          isAdmin() ||
          (
            incoming().status == 'published' &&
            incoming().ownerReply == '' &&
            incoming().ownerRepliedAt == null &&
            (
              (
                isVerifiedUser() &&
                incoming().authorUid == request.auth.uid &&
                incoming().verifiedAccount == true
              ) ||
              (
                !isSignedIn() &&
                incoming().authorUid == '' &&
                incoming().verifiedAccount == false
              )
            )
          )
        );
      allow update: if isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isAdmin() &&
            (
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'ownerReply',
                  'ownerRepliedAt'
                ]) &&
                (
                  (incoming().ownerReply.size() > 0 && incoming().ownerRepliedAt == request.time) ||
                  (incoming().ownerReply == '' && incoming().ownerRepliedAt == null)
                )
              ) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'authorName',
                'location',
                'purchaseCategory',
                'rating',
                'comment',
                'status',
                'helpfulCount',
                'authorUid',
                'verifiedAccount',
                'ownerReply',
                'ownerRepliedAt'
              ])
            )
          ) ||
          (
            incoming().authorUid == existing().authorUid &&
            incoming().verifiedAccount == existing().verifiedAccount &&
            (
              (
                isVerifiedUser() &&
                existing().authorUid != '' &&
                existing().authorUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'authorName',
                  'location',
                  'purchaseCategory',
                  'rating',
                  'comment'
                ])
              ) ||
              (
                existing().status == 'published' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) &&
                incoming().helpfulCount == existing().helpfulCount + 1
              )
            )
          )
        );
      allow delete: if isValidId(reviewId) && (
        isAdmin() ||
        (
          isVerifiedUser() &&
          existing().authorUid != '' &&
          existing().authorUid == request.auth.uid
        )
      );
    }

    // Customer enquiries (contains PII mobile numbers -> strict owner-only read)
    match /enquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && isAdmin();
      allow list: if isBootstrappedOwner();
      allow create: if isValidId(enquiryId) &&
        isValidEnquiry(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(enquiryId) &&
        isAdmin() &&
        isValidEnquiry(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(enquiryId) && isAdmin();
    }

    // Admin registry for verified owner
    match /admins/{userId} {
      allow get: if isValidId(userId) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isAdmin();
      allow list: if false;
      allow create: if isValidId(userId) &&
        isBootstrappedOwner() &&
        request.auth.uid == userId &&
        isValidAdminUser(incoming()) &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Public farm contact details managed by owner
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'publicContact';
      allow list: if false;
      allow create: if isValidId(settingId) &&
        settingId == 'publicContact' &&
        isAdmin() &&
        isValidFarmSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) &&
        settingId == 'publicContact' &&
        isAdmin() &&
        isValidFarmSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'phoneDisplay',
          'whatsappDigits',
          'email',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
